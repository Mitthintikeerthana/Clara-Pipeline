# ─────────────────────────────────────────────────────────────────────────────
# Clara Pipeline — Environment Variables
# Copy this file to `.env` and fill in your values.
# Load it before running:  source .env  (Linux/Mac) or `set -a; . .env; set +a`
# On Windows:              set /p values manually, or use a tool like direnv
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM: Google Gemini (FREE — no credit card required) ──────────────────────
# Get your key at: https://aistudio.google.com/  (free AI Studio API key)
# Free tier: gemini-1.5-flash — 15 requests/min, 1M tokens/min, 1500 req/day
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (gemini-1.5-flash is the free-tier workhorse)
GEMINI_MODEL=gemini-2.5-flash

# ── Task Tracker: GitHub Issues (FREE) ───────────────────────────────────────
# Create a Personal Access Token at: https://github.com/settings/tokens
# Required scopes: repo (to create issues on a private repo) or public_repo
# Format for GITHUB_REPO: "owner/repository-name" (no https, no .git)
GITHUB_TOKEN=your_github_pat_here
GITHUB_REPO=your-username/your-repo-name

# ── Retell AI (OPTIONAL — free tier, manual import if no API access) ──────────
# Get API key at: https://app.retellai.com/  (free tier available)
# If you don't have a key, agent specs are still generated for manual import.
RETELL_API_KEY=

# ── Whisper (LOCAL — no key required) ────────────────────────────────────────
# Model size: tiny (fastest) | base | small | medium | large (most accurate)
# Start with "base" — it's fast and handles clean recordings well.
# Install: pip install openai-whisper
WHISPER_MODEL=base

# ── Pipeline Behaviour ────────────────────────────────────────────────────────
# Set to "true" to skip all external API calls (useful for testing)
DRY_RUN=false

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
